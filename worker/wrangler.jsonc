{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "duck-facilitator",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "vars": {
    "OPENAI_MODEL": "gpt-4o-mini"
  },
  "secrets": {
    "required": ["OPENAI_API_KEY"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room"
      },
      {
        "name": "GLOBAL_LIMITER",
        "class_name": "GlobalLimiter"
      }
    ]
  },
  "exports": {
    "Room": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "GlobalLimiter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
